medianStepsPerDay = median(totalStepsPerDay$Steps_per_day, na.rm=T)
hist(totalStepsPerDay$Steps_per_day)
ggplot(totalStepsPerDay, aes(Steps_per_day)) +
geom_histogram(binwidth=2500) +
